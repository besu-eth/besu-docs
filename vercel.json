    { "source": "/private-networks/how-to/send-transactions/concurrent-private-transactions", "destination": "/public-networks/how-to/send-transactions", "permanent": true },
    { "source": "/private-networks/concepts/plugins", "destination": "/plugins", "permanent": true },
